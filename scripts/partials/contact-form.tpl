<form id="inquiry-form" novalidate><p id="delivery-note" class="form-note">JavaScript is required for secure online inquiries. The form is not yet configured for live delivery.</p><noscript><p>Enable JavaScript to use the form. No inquiry has been sent.</p></noscript><div class="form-grid"><div><label for="name">Your name <span>(required)</span></label><input id="name" name="name" autocomplete="name" required maxlength="120"></div><div><label for="email">Email address <span>(required)</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"></div><div><label for="company">Company name <span>(required)</span></label><input id="company" name="company" autocomplete="organization" required maxlength="160"></div><div><label for="company-type">Type of organization</label><select id="company-type" name="company_type"><option value="">Please select</option><option>Insurer</option><option>MGA / MGU</option><option>Reinsurer</option><option>Broker</option><option>Program administrator</option><option>Other</option></select></div></div><label for="interest">Primary area of interest <span>(required)</span></label><select id="interest" name="interest" required><option value="">Choose a topic</option><option value="demo">Insurance software / EclipseSME demo</option><option value="modernization">Software implementation & modernization</option><option value="consulting">Insurance technology consulting</option><option value="leadership">Fractional CIO / COO / CTO leadership</option><option value="coaching">Team development & coaching</option><option value="assessment">Eclipse Totality Assessment™</option><option value="audit">Audit readiness</option><option value="security">Security review</option><option value="other">Other / more than one service</option></select><fieldset><legend>Preferred contact method(s)</legend><p class="field-hint">Select any that apply. Email is selected by default.</p><div class="contact-options"><label><input type="checkbox" name="contact_method" value="Email" checked> Email</label><label><input type="checkbox" name="contact_method" value="Phone"> Phone call</label><label><input type="checkbox" name="contact_method" value="SMS"> SMS / text</label></div></fieldset><label for="phone">Phone number <span>(required for a call or text)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"><label for="message">How can we help? <span>(required)</span></label><textarea id="message" name="message" rows="5" required minlength="10" maxlength="5000" aria-describedby="message-hint"></textarea><p class="field-hint" id="message-hint">Tell us about the services you need and your priorities. Do not include confidential, financial or policyholder information.</p><div class="honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="_gotcha" tabindex="-1" autocomplete="off"></div><div id="form-captcha"></div><p class="form-privacy">We use your information to respond to your inquiry. Read our <a href="@ROOT@privacy-policy/index.html">Cookies & privacy</a> information.</p><button class="button" type="submit" disabled>Send inquiry <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></button><p id="form-status" class="form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden></p></form>
